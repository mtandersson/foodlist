{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:mcp-app",
    "build:mcp-app": "vite build --config vite.mcp-app.config.ts && MCP_APP=recipes vite build --config vite.mcp-app.config.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --tsgo && node ./node_modules/typescript/bin/tsc -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.1",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "uuid": "^14.0.2",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.1.0"
  }
}
